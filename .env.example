# =============================================================================
# Space Light — variáveis de ambiente
# =============================================================================
# Copie este arquivo para ".env.local" (desenvolvimento) ou configure estas
# variáveis no painel da Vercel (produção). NUNCA versione os valores reais.

# -----------------------------------------------------------------------------
# Banco de dados
# -----------------------------------------------------------------------------
# PRODUÇÃO (Vercel): defina as duas variáveis abaixo para usar o Turso (libSQL).
# Quando TURSO_DATABASE_URL está presente, o app usa o Turso automaticamente.
TURSO_DATABASE_URL="libsql://SEU-BANCO-SEU-USUARIO.turso.io"
TURSO_AUTH_TOKEN="cole-aqui-o-token-do-turso"

# DESENVOLVIMENTO LOCAL: deixe TURSO_DATABASE_URL vazio/ausente para usar um
# arquivo SQLite local via better-sqlite3. Opcionalmente ajuste o caminho:
# DATABASE_PATH="./data/space-light.sqlite"

# -----------------------------------------------------------------------------
# Autenticação / sessão
# -----------------------------------------------------------------------------
# Segredo usado para assinar os cookies de sessão. Gere um valor longo e único.
AUTH_SESSION_SECRET="gere-um-segredo-longo-e-aleatorio"

# -----------------------------------------------------------------------------
# Conta administrativa inicial (equipe Space Light)
# -----------------------------------------------------------------------------
# O hash e o salt são derivados da senha inicial pelo mesmo algoritmo do app.
# Não coloque a senha em texto puro aqui.
SPACE_ADMIN_EMAIL="gestao@spacelightengenharia.com.br"
SPACE_ADMIN_PASSWORD_HASH="cole-aqui-o-hash"
SPACE_ADMIN_PASSWORD_SALT="cole-aqui-o-salt"

# -----------------------------------------------------------------------------
# URL pública da aplicação (opcional, usada em links absolutos)
# -----------------------------------------------------------------------------
# APP_URL="https://www.spacelightengenharia.com.br"

# -----------------------------------------------------------------------------
# Envio de e-mail (Resend) — usado no "Esqueci minha senha"
# -----------------------------------------------------------------------------
# Sem estas duas variáveis, a tela de recuperação volta a apenas orientar o
# contato com a equipe (não quebra).
RESEND_API_KEY="re_..."
MAIL_FROM="Space Light Engenharia <nao-responda@mail.spacelightengenharia.com.br>"

# -----------------------------------------------------------------------------
# Armazenamento de arquivos (Vercel Blob)
# -----------------------------------------------------------------------------
# Criado automaticamente ao conectar o Blob Store ao projeto na Vercel.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# -----------------------------------------------------------------------------
# Avaliações do Google na home (opcional)
# -----------------------------------------------------------------------------
# Chave da Places API (New), restrita a essa API e ao IP do servidor, e o Place
# ID do perfil da Space Light (Embu das Artes). Sem as duas, a home mostra as
# avaliações fixas. Cada consulta é do SKU "Place Details Enterprise +
# Atmosphere": 1.000 grátis por mês, depois US$ 25 por mil.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=
